# Local meeting MVP settings. Copy to .env or export these variables.
MEETING_DATA_DIR=
MEETING_CHUNK_SECONDS=300
MEETING_QUEUE_CHUNKS=32
MEETING_STT_BACKEND=whisper
MEETING_WHISPER_MODEL=base
# Optional OpenAI-compatible local ASR server:
MEETING_ASR_URL=http://127.0.0.1:8080/v1
MEETING_ASR_MODEL=
# Local-first Ollama. Use the host, /api/chat, or legacy /v1 base URL.
MEETING_LLM_BACKEND=ollama
MEETING_LLM_URL=http://127.0.0.1:11434
MEETING_LLM_MODEL=gemma3:1b
# Set backend=openai for /v1/chat/completions-compatible servers.
# MEETING_LLM_BACKEND=openai
# MEETING_LLM_URL=http://127.0.0.1:11434/v1
MEETING_ALLOW_NETWORK=false
MEETING_REQUEST_TIMEOUT=120
MEETING_LANGUAGE=
